{
  "manifest_version": 3,
  "name": "二维码识别",
  "version": "1.0.0",
  "description": "右键识别图片中的二维码",
  "permissions": ["contextMenus", "scripting"],
  "host_permissions": ["<all_urls>", "*://*/*", "file:///*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
